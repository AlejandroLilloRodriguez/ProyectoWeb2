meta {
  name: 04 Confirm Player Deleted
  type: http
  seq: 4
  tags: [
    cleanup
    players
  ]
}

get {
  url: {{baseUrl}}/players/{{playerId}}
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:3000/api/v1
}

tests {
  test("created player is gone", function () {
    expect(res.status).to.equal(404);
    expect(res.body.error).to.have.property("code", "NOT_FOUND");
  });
}
