meta {
  name: 06 Patch Game
  type: http
  seq: 6
  tags: [
    games
    crud
  ]
}

patch {
  url: {{baseUrl}}/games/{{gameId}}
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "status": "finished",
    "homeScore": 101,
    "awayScore": 99,
    "winnerTeamId": "{{teamId}}"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000/api/v1
}

tests {
  test("patches the game", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("id", bru.getVar("gameId"));
    expect(res.body).to.include({
      status: "finished",
      homeScore: 101,
      awayScore: 99,
      winnerTeamId: bru.getVar("teamId")
    });
  });
}
