meta {
  name: 05 Replace Game
  type: http
  seq: 5
  tags: [
    games
    crud
  ]
}

put {
  url: {{baseUrl}}/games/{{gameId}}
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "season": 2025,
    "date": "2025-01-20T00:00:00.000Z",
    "status": "scheduled",
    "phase": "regular",
    "homeTeamId": "{{teamId}}",
    "awayTeamId": "{{awayTeamId}}",
    "arena": "Replacement Arena",
    "city": "Replace City"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000/api/v1
}

tests {
  test("replaces the game", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.include({
      id: bru.getVar("gameId"),
      season: 2025,
      status: "scheduled",
      phase: "regular",
      homeTeamId: bru.getVar("teamId"),
      awayTeamId: bru.getVar("awayTeamId")
    });
  });
}
