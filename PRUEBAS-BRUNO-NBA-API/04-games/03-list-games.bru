meta {
  name: 03 List Games
  type: http
  seq: 3
  tags: [
    games
    read
  ]
}

get {
  url: {{baseUrl}}/games?teamId={{teamId}}&season=2024&page=1&limit=10
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:3000/api/v1
}

tests {
  test("returns paginated games", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("data").that.is.an("array");
    expect(res.body).to.have.property("pagination");
    expect(res.body.pagination).to.include({ page: 1, limit: 10 });
  });
  
  test("includes created game", function () {
    const gameId = bru.getVar("gameId");
    expect(res.body.data.some((game) => game.id === gameId)).to.equal(true);
  });
}
