meta {
  name: 04 Get Game By Id
  type: http
  seq: 4
  tags: [
    games
    read
  ]
}

get {
  url: {{baseUrl}}/games/{{gameId}}
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:3000/api/v1
}

tests {
  test("returns created game", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("id", bru.getVar("gameId"));
    expect(res.body).to.have.property("homeTeamId", bru.getVar("teamId"));
    expect(res.body).to.have.property("awayTeamId", bru.getVar("awayTeamId"));
  });
}
