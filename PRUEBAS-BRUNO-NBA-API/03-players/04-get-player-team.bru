meta {
  name: 04 Get Player Team
  type: http
  seq: 4
  tags: [
    players
    teams
    relation
  ]
}

get {
  url: {{baseUrl}}/players/{{playerId}}/team
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:3000/api/v1
}

tests {
  test("returns player's team", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("id", bru.getVar("teamId"));
  });
}
