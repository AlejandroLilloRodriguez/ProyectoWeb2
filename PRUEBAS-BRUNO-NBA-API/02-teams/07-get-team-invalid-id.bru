meta {
  name: 07 Get Team Invalid Id
  type: http
  seq: 7
  tags: [
    teams
    negative
  ]
}

get {
  url: {{baseUrl}}/teams/not-a-valid-id
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:3000/api/v1
}

tests {
  test("rejects malformed team id", function () {
    expect(res.status).to.equal(400);
    expect(res.body.error).to.have.property("code", "BAD_REQUEST");
  });
}
